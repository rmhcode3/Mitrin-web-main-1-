# Frontend (public) - Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-side only (migrations / dev seed). Never expose these to the browser.
DATABASE_URL_SESSION=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Development only: enables npm run db:seed
ALLOW_DEV_SEED=false
